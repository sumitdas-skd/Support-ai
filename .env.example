# OpenRouter API Key — used for all AI calls (OpenAI-compatible, routes to google/gemini-2.0-flash)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for OpenRouter HTTP-Referer header, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: No longer required — OpenRouter is used instead.
# Leave blank unless switching back to direct Google AI Studio.
GEMINI_API_KEY=

# Database & Vector DB Configuration (Optional / production PostgreSQL with pgvector)
DATABASE_URL=

# Stripe Billing Configuration (Optional for production payment processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_GROWTH_ID=
STRIPE_PRICE_PRO_ID=
